# .env.example — 이 파일을 복사해 .env를 만들고 값을 채우세요. (.env는 커밋 금지)

# 실행 환경: development | production
APP_ENV=development

# 세션 서명용 비밀키. 운영 환경에서는 반드시 긴 임의 문자열로 설정하세요.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 데이터베이스. 비워두면 로컬 SQLite(sadari.db)를 사용합니다.
# 운영 예: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# AI 공급자: mock | anthropic
# 비워두면 ANTHROPIC_API_KEY가 있을 때 anthropic, 없으면 mock(모의 AI 모드)로 동작합니다.
LLM_PROVIDER=
ANTHROPIC_API_KEY=

# 모델 설정 (기본값: 코치는 Claude Opus 5.5, 분류·추출 등 경량 작업은 Claude Haiku 4.5)
# 비용을 줄이려면 COACH_MODEL=claude-sonnet-5-5 로 바꿔 품질을 비교해보세요.
COACH_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-4-5
COACH_EFFORT=medium
# 안전 분류기로 응답이 거절되면 서버가 다른 모델로 자동 재시도 (Opus 5.5 권장 설정)
REFUSAL_FALLBACK=true

# 사용자 1인당 하루 AI 코치 메시지 상한
DAILY_CHAT_LIMIT=50

# n8n 등 내부 자동화가 /internal/* API를 호출할 때 쓰는 키
INTERNAL_API_KEY=

# DATA-02/03: 실제 값은 .env 또는 배포 환경에만 설정
YOUTHCENTER_API_KEY=
FSS_API_KEY=
# 영속 디스크 경로 권장. 여러 앱 프로세스에서는 저장소/캐시 설계 협의 필요
POLICY_EXTERNAL_FILE=
