# .env.example — 이 파일을 복사해 .env를 만들고 값을 채우세요. (.env는 커밋 금지)

# 실행 환경: development | production
APP_ENV=development

# 세션 서명용 비밀키. 운영 환경에서는 반드시 긴 임의 문자열로 설정하세요.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 데이터베이스. 비워두면 로컬 SQLite(sadari.db)를 사용합니다.
# 운영 예: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# AI 공급자: mock | anthropic
# 비워두면 ANTHROPIC_API_KEY가 있을 때 anthropic, 없으면 mock(모의 AI 모드)로 동작합니다.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# 팀 공용 키(sk-cody-live-...)는 코디세이 중계 서버용이라 접속 주소가 반드시 있어야 합니다.
# Anthropic에서 직접 받은 키(sk-ant-...)를 쓸 때만 이 줄을 비우세요(비우면 api.anthropic.com).
ANTHROPIC_BASE_URL=https://copa.codyssey.kr

# 모델 설정. 코디세이 중계 서버는 모델 이름이 다릅니다(콘솔 '문서'의 모델 표 참고).
# 코디세이: claude-sonnet-4(Sonnet 4.6), claude-haiku-4(Haiku 4.5), claude-opus-4-8, claude-opus-4-7
# Anthropic 직접 키: COACH_MODEL=claude-opus-5-5, FAST_MODEL=claude-haiku-4-5
COACH_MODEL=claude-sonnet-4
FAST_MODEL=claude-haiku-4
COACH_EFFORT=medium
# 안전 분류기로 응답이 거절되면 서버가 다른 모델로 자동 재시도 (Opus 5.5 권장 설정)
REFUSAL_FALLBACK=true

# 사용자 1인당 하루 AI 코치 메시지 상한
DAILY_CHAT_LIMIT=50

# n8n 등 내부 자동화가 /internal/* API를 호출할 때 쓰는 키
INTERNAL_API_KEY=