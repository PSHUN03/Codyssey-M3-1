{
  "name": "W3 피드백을 GitHub Issue로 (FR-17)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sadari-feedback",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "sadari-feedback"
    },
    {
      "parameters": {
        "jsCode": "// 사다리 서버가 보낸 피드백으로 이슈 제목과 본문을 만든다. 금액·민감정보는 서버에서 이미 가렸다\nconst d = $input.first().json.body || {};\nconst head = (d.comment || d.question || '의견 없음').replace(/\\s+/g, ' ').slice(0, 30);\nconst tools = (d.tools_used || []).join(', ') || '없음';\nconst body = [\n  '사용자 테스트 중 들어온 \\'아쉬워요\\' 피드백입니다. 자동으로 만들어졌습니다.',\n  '',\n  '**의견**', '', d.comment || '(의견 없음)', '',\n  '**질문**', '', d.question || '', '',\n  '**AI 답변**', '', d.answer || '', '',\n  `- 사용한 도구: ${tools}`,\n  `- 근거 없는 금액 표시(flagged): ${d.flagged ? '예' : '아니요'}`,\n  `- 피드백 ID: ${d.feedback_id}, 시각: ${d.created_at}`,\n].join('\\n');\nreturn [{ json: { title: `[피드백] ${head}`, body } }];"
      },
      "name": "이슈 내용 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/PSHUN03/Codyssey-M3-1/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, body: $json.body, labels: ['user-feedback'] }) }}",
        "options": {}
      },
      "name": "GitHub 이슈 만들기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/디스코드_웹훅_주소를_넣으세요",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: '새 사용자 피드백 이슈: ' + $json.html_url }) }}",
        "options": {}
      },
      "name": "디스코드 알림",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ]
    }
  ],
